{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users,actions,notifications",
        "X-MCP-Readonly": "true"
      },
      "oauth": false
    }
  },
  "tools": {
    "atlassian_*": false,
    "github_*": false
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "uv *": "allow",
      "poetry *": "allow",
      "pip *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "npm run *": "allow",
      "bun *": "allow",
      "sync-ai-config": "allow",
      "sync-ai-config --check": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "rm -rf *": "deny",
      "git push --force *": "deny"
    }
  },
  "instructions": [
    "~/.config/ai/AGENTS.md"
  ]
}